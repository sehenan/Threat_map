| makeresults count=8
| streamstats count as i
| eval _time = now() - 300 + i,
       Country = "Russia", src_lat = 61.52, src_lon = 105.31,
       ip = case(i <= 2, "203.0.113.7", i == 3, "203.0.113.8", i == 4, "203.0.113.9", true(), "203.0.113.10"),
       req = case(i <= 2, "AAA111", i == 3, "BBB222", i == 4, "CCC333", true(), "DDD444"),
       detail = case(
         i == 1, "Warning. detected SQLi using libinjection. [id \"942100\"] [msg \"SQL Injection Attack Detected via libinjection\"] [severity \"2\"] [tag \"application-multi\"] [tag \"attack-sqli\"]",
         i == 2, "Access denied with code 403 (phase 2). [id \"949110\"] [msg \"Inbound Anomaly Score Exceeded (Total Score: 10)\"] [severity \"0\"] [tag \"anomaly-evaluation\"] [tag \"attack-generic\"]",
         i == 3, "Access denied with code 403 (phase 2). [id \"949110\"] [msg \"Inbound Anomaly Score Exceeded (Total Score: 5)\"] [severity \"0\"] [tag \"attack-generic\"]",
         i == 4, "Warning. Matched XSS filter. [id \"941100\"] [msg \"XSS Attack Detected via libinjection\"] [severity \"2\"] [tag \"attack-xss\"]",
         i == 5, "Warning. Matched \"Operator PmFromFile\" against variable ARGS:file [id \"932160\"] [msg \"Remote Command Execution: Unix Shell Code Found\"] [severity \"2\"] [tag \"attack-rce\"]",
         i == 6, "Warning. Matched \"Operator PmFromFile\" against variable ARGS:file [id \"930120\"] [msg \"OS File Access Attempt\"] [severity \"2\"] [tag \"attack-lfi\"]",
         i == 7, "Warning. Matched \"Operator Rx\" against variable ARGS:file [id \"930110\"] [msg \"Path Traversal Attack (/../) or (/.../)\"] [severity \"2\"] [tag \"attack-lfi\"]",
         true(), "Access denied with code 403 (phase 2). Matched \"Operator Ge' with parameter 5' against variable TX:BLOCKING_INBOUND_ANOMALY_SCORE' (Value: '30' ) [id \"949110\"] [msg \"\"] [severity \"0\"] [tag \"anomaly-evaluation\"] [tag \"OWASP_CRS\"]"),
       entete = if(match(detail, "^Access denied"), "[client " . ip . "] ", ""),
       _raw = "Oct  5 09:00:00 waf bunkerweb: 2026/10/05 09:00:00 [error] 77#77: *12 " . entete . "ModSecurity: " . detail . " [hostname \"www.example.org\"] [uri \"/\"] [unique_id \"" . req . "\"] [ref \"\"], client: " . ip . ", server: www.example.org, request: \"GET / HTTP/1.1\", host: \"www.example.org\""
| fields - ip, req, detail, entete
