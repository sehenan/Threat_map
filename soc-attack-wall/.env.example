# Copiez ce fichier en .env (ignore par git) et completez-le.

# Acceptation de la licence Splunk : a renseigner vous-meme apres lecture.
#   SPLUNK_START_ARGS=--accept-license
#   SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com
# https://www.splunk.com/en_us/legal/splunk-general-terms.html
SPLUNK_START_ARGS=
SPLUNK_GENERAL_TERMS=

# Mot de passe du compte admin (8 caracteres minimum).
SPLUNK_PASSWORD=

# Jeton du HTTP Event Collector : celui que Zabbix, iTop... presentent pour envoyer
# leurs evenements. Un UUID de votre choix :
#   python -c "import uuid; print(uuid.uuid4())"
SPLUNK_HEC_TOKEN=

# Version du paquet dans dist/ et fuseau horaire de l'ecran.
WALL_VERSION=1.5.2
TZ=Africa/Abidjan
